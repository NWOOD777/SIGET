DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
SIGET_PUBLIC_URL=http://localhost:8000

POSTGRES_DB=siget_db
POSTGRES_USER=siget_dev
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

AUTH0_DOMAIN=your-auth0-domain
AUTH0_CLIENT_ID=your-auth0-client-id
AUTH0_CLIENT_SECRET=your-auth0-client-secret
AUTH0_DB_CONNECTION=Username-Password-Authentication
AUTH0_MGMT_CLIENT_ID=your-auth0-management-client-id
AUTH0_MGMT_CLIENT_SECRET=your-auth0-management-client-secret
AUTH0_MGMT_AUDIENCE=https://your-auth0-domain/api/v2/

# Configuración de Access Tokens / Bearer (Aplicación de Escritorio PySide6)
# Identificador de la API registrada en Auth0 (Audience esperada en access tokens)
AUTH0_API_AUDIENCE=https://api.siget.local
# Client IDs admitidos por Django (claim azp), separados por coma. Auth0 emite los tokens.
AUTH0_API_ALLOWED_CLIENT_IDS=
AUTH0_JWKS_CACHE_SEGUNDOS=600
AUTH0_TOKEN_LEEWAY=10
AUTH0_HTTP_TIMEOUT=5

# Cliente nativo: identificador propio, sin client_secret.
AUTH0_DESKTOP_CLIENT_ID=
AUTH0_DESKTOP_CALLBACK_PORT=42813
SIGET_HTTP_TIMEOUT=10
